    "release:verify": "node scripts/release/verify-release.mjs",
    "release:verify:all": "node scripts/release/verify-all.mjs",
    "verify:structure": "node scripts/verify-structure.mjs"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10",
    "yaml": "2.9.0"
