{
  "name": "go-lang-starter",
  "version": "0.0.0",
  "private": true,
  "description": "Development and release-contract tooling for the go-lang-starter suite.",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24.0.0 <25.0.0",
    "pnpm": ">=11.0.0 <12.0.0"
  },
  "scripts": {
    "test:release": "vitest run integration/tests/release",
    "test:deploy-contract": "vitest run integration/tests/deploy-contract.test.ts",
