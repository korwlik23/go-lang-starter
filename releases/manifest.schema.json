{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tewarach-dev.me/schemas/release-manifest-v1.json",
  "title": "go-lang-starter release manifest",
  "type": "object",
  "required": [
    "schemaVersion",
    "suite",
    "components",
    "contracts",
    "infraStack",
    "databaseSupport"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "suite": {
      "type": "object"
    },
    "components": {
      "type": "object"
    },
    "contracts": {
      "type": "object"
    },
    "infraStack": {
      "type": "object"
    },
    "databaseSupport": {
      "type": "array"
    }
  }
}
