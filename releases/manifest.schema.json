{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tewarach-dev.me/schemas/release-manifest-v1.json",
  "title": "go-lang-starter release manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "suite",
    "components",
    "contracts",
    "infraStack",
    "databaseSupport"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "suite": {
      "$ref": "#/$defs/suite"
    },
    "components": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "api",
        "admin",
        "site"
      ],
      "properties": {
        "api": {
          "$ref": "#/$defs/component"
        },
        "admin": {
          "$ref": "#/$defs/component"
        },
        "site": {
          "$ref": "#/$defs/component"
        }
      }
    },
    "contracts": {
      "$ref": "#/$defs/contracts"
    },
    "infraStack": {
      "$ref": "#/$defs/infraStack"
    },
    "databaseSupport": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/databaseSupport"
      }
    }
  },
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "componentTag": {
      "type": "string",
      "pattern": "^v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "suiteTag": {
      "type": "string",
      "pattern": "^suite-v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "gitCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "repository": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "immutableImage": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*(?::[0-9]+)?(?:/[a-z0-9]+(?:[._-][a-z0-9]+)*)+@sha256:[0-9a-f]{64}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1
    },
    "suite": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "tag"
      ],
      "properties": {
        "version": {
          "$ref": "#/$defs/semver"
        },
        "tag": {
          "$ref": "#/$defs/suiteTag"
        }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "repository",
        "version",
        "tag",
        "commit",
        "image"
      ],
      "properties": {
        "path": {
          "enum": [
            "api",
            "admin",
            "site"
          ]
        },
        "repository": {
          "$ref": "#/$defs/repository"
        },
        "version": {
          "$ref": "#/$defs/semver"
        },
        "tag": {
          "$ref": "#/$defs/componentTag"
        },
        "commit": {
          "$ref": "#/$defs/gitCommit"
        },
        "image": {
          "$ref": "#/$defs/immutableImage"
        }
      }
    },
    "contractArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "path",
        "sha256"
      ],
      "properties": {
        "version": {
          "$ref": "#/$defs/semver"
        },
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "contracts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "openapi",
        "localizationCatalog"
      ],
      "properties": {
        "openapi": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "admin",
            "public",
            "siteServer"
          ],
          "properties": {
            "admin": {
              "$ref": "#/$defs/contractArtifact"
            },
            "public": {
              "$ref": "#/$defs/contractArtifact"
            },
            "siteServer": {
              "$ref": "#/$defs/contractArtifact"
            }
          }
        },
        "localizationCatalog": {
          "$ref": "#/$defs/contractArtifact"
        }
      }
    },
    "deployScript": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "mode"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "mode": {
          "const": "100755"
        }
      }
    },
    "infraStack": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "commit",
        "deployScript"
      ],
      "properties": {
        "repository": {
          "$ref": "#/$defs/repository"
        },
        "commit": {
          "$ref": "#/$defs/gitCommit"
        },
        "deployScript": {
          "$ref": "#/$defs/deployScript"
        }
      }
    },
    "databaseSupport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "status"
      ],
      "properties": {
        "profile": {
          "enum": [
            "postgresql",
            "mariadb-xampp",
            "mysql-oracle"
          ]
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "supported",
            "not-supported",
            "not-tested"
          ]
        },
        "evidence": {
          "$ref": "#/$defs/relativePath"
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "const": "supported"
              }
            }
          },
          "then": {
            "properties": {
              "version": {
                "type": "string",
                "minLength": 1
              },
              "evidence": {
                "$ref": "#/$defs/relativePath"
              }
            },
            "required": [
              "version",
              "evidence"
            ]
          }
        }
      ]
    }
  }
}
